# Copiar a backend/.env. Sin este archivo el backend apunta a Anvil (31337).

# ─── Red: HashKey Chain Testnet ──────────────────────────────────────────────
CHAIN_ID=133
RPC_URL=https://testnet.hsk.xyz

# Llave del operador: la MISMA que desplegó los contratos (contracts/.env
# PRIVATE_KEY). Es la única que puede crear proyectos, dar KYC y fijar políticas.
OPERATOR_PRIVATE_KEY=0x...

# ─── Cuentas de la demo (seed / e2e) ─────────────────────────────────────────
# Llaves nuevas, NUNCA las de Anvil: en una red pública los bots las vacían.
# Generar con:  cast wallet new      Fondear con:  npm run fund:demo
DEMO_DEVELOPER_KEY=0x...
DEMO_LEGAL_KEY=0x...
DEMO_SUPERVISOR_KEY=0x...
DEMO_INVESTOR_A_KEY=0x...
DEMO_INVESTOR_B_KEY=0x...
DEMO_INVESTOR_C_KEY=0x...
DEMO_INVESTOR_D_KEY=0x...

# ─── Opcionales ──────────────────────────────────────────────────────────────
# PORT=4000
# PINATA_JWT=
